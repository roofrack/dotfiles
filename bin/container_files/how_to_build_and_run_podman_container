#!/usr/bin/env bash
# ------------------------------------------------
# How to build and run a container using podman.
# In this example we are creating a container for
# opencode ai.
# ------------------------------------------------

# 1) create a Dockerfile or in podman you call it a Containerfile (use a capital C)
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates \
  git \
  bash &&
  rm -rf /var/lib/apt/lists/*
RUN npm install -g opencode-ai
WORKDIR /workspace
ENTRYPOINT []
CMD ["bash"]

# 2) Build the image for the container...
#       the -t flag is for tag (you provide a name for the image)
podman build -t opencode-runner:local .

# 3) Run the container using the image 'opencode-runner'...
#      Only run this command once for starting a new container.
podman run -it --name opencode-session \
  -v "$(pwd)":/workspace:z \
  -v "$HOME/.local/share/opencode:/root/.local/share/opencode:z" \
  opencode-runner:local opencode .

# 4) When exiting out of opencode the container stops. When you want to
#    restart the opencode container use...
#    -ai is for attach interactive
#podman start -ai <container_name_or_id>
